# Settings for docker compose. Copy this file to .env (git-ignored) and fill in your values.
# Every variable is optional unless noted. A blank value uses the default.
# A variable is its configuration key in upper snake case: Ai:Gemini:ApiKey is AI_GEMINI_API_KEY, Api:Health:ExposeConfig is API_HEALTH_EXPOSE_CONFIG. The standard OTEL_* variables keep their names.
# Each parameter is documented in the comment lines above it: definition, type, required or optional, default and special format.
# `dotnet run` does not read this file, only docker compose does.

# AI provider
# Definition: which AI provider extracts the query and writes the explanations.
# Type: string, one of Gemini or OpenAiCompatible (the sample line below lists both, keep only one).
# Optional. Default: Gemini. An unknown value stops the app at startup.
AI_PROVIDER=Gemini|OpenAiCompatible

# Model
# Definition: the model name sent to the selected provider, for both AI steps.
# Type: string, a model id of the selected provider, for example gemini-3.8-flash for Gemini or openai/gpt-oss-20b for Groq. Optional.
# Default: blank, which uses the default of the selected provider (gemini-3.8-flash for Gemini, openai/gpt-oss-20b for OpenAiCompatible). Change it together with AI_PROVIDER.
# A routing name such as auto picks a different upstream model per call and can be slow enough to time out (30 seconds).
AI_MODEL=

# Generation settings sent to either provider. Blank means: temperature 0, and nothing else is sent.
# A gateway or model that does not support top-k, seed or reasoning effort may reject them (xAI accepted seed, top-p and reasoning effort for grok-4.7 on 2026-10-14), so leave those blank unless you have tried them.
# An out-of-range value is not sent and /api/health/ready reports the setting as invalid.

# Definition: how random the model's choices are (0 is the most repeatable).
# Type: decimal number from 0 to 2. Optional. Default: 0 when blank.
AI_TEMPERATURE=
# Definition: the model only picks from the K most likely next words.
# Type: integer, 1 or more. Optional. Default: not sent, the provider's default applies. Not part of the OpenAI chat API, so leave blank for gateways that reject unknown parameters.
AI_TOP_K=
# Definition: the model only picks from the smallest set of words whose probabilities add up to P (nucleus sampling).
# Type: decimal number above 0 and at most 1. Optional. Default: not sent, the provider's default applies.
AI_TOP_P=
# Definition: asks the provider to repeat its choices for the same input, as far as it supports that. It does not guarantee identical text.
# Type: integer, any value. Optional. Default: not sent.
AI_SEED=
# Definition: how much the model reasons before answering. Gemini gets it as thinkingConfig.thinkingLevel, an OpenAI-compatible gateway as reasoning_effort.
# Type: short lowercase word such as minimal, low, medium or high (the accepted words depend on the model). Format: starts with a letter, then letters, digits, hyphens or underscores, up to 20 characters.
# Optional. Default: not sent, the model's default applies. A model that does not support it rejects it and every search falls back to basic parsing.
AI_REASONING_EFFORT=

# AI resilience: how calls to the AI provider are retried, timed out and cut off. Applies to either provider.
# While the circuit is open, searches skip the AI and use basic parsing at once (aiUsed false) instead of waiting for a timeout.
# An out-of-range value stops /api/health/ready from reporting ready (the setting is named, its value is not printed).

# Definition: retries after a 5xx response or a network error. A timeout, a 429 and other 4xx responses are never retried.
# Type: integer, 0 or more. Optional. Default: 1. Use 0 to turn the retry off.
AI_RESILIENCE_RETRY_COUNT=
# Definition: pause before a retry.
# Type: integer, milliseconds, 0 or more. Optional. Default: 300.
AI_RESILIENCE_RETRY_DELAY_MS=
# Definition: how long one attempt may take before it is cancelled and counted as a failure.
# Type: integer, milliseconds, above 0. Optional. Default: 30000.
AI_RESILIENCE_ATTEMPT_TIMEOUT_MS=
# Definition: how long the whole call may take, retries included.
# Type: integer, milliseconds, not less than the attempt timeout. Optional. Default: 45000.
AI_RESILIENCE_TOTAL_TIMEOUT_MS=
# Definition: share of failed calls within the sampling window that opens the circuit. A 429 counts as a failure.
# Type: decimal number above 0 and at most 1. Optional. Default: 0.5.
AI_RESILIENCE_BREAKER_FAILURE_RATIO=
# Definition: fewest calls in the sampling window before the circuit may open.
# Type: integer, 2 or more. Optional. Default: 4.
AI_RESILIENCE_BREAKER_MINIMUM_THROUGHPUT=
# Definition: length of the window in which failures are counted.
# Type: integer, seconds, above 0. Optional. Default: 30.
AI_RESILIENCE_BREAKER_SAMPLING_SECONDS=
# Definition: how long an open circuit rejects calls before it lets one through to test the provider again.
# Type: integer, seconds, above 0. Optional. Default: 30.
AI_RESILIENCE_BREAKER_BREAK_SECONDS=

# Gemini (used when AI_PROVIDER=Gemini)
# Definition: Google Gemini API key. Get one at https://ai.google.dev/gemini-api/docs/api-key
# Type: string, secret (never commit it). Required only when AI_PROVIDER=Gemini, without it the app runs in fallback mode with aiUsed false. Default: none.
AI_GEMINI_API_KEY=ApiK*********************************************last

# OpenAI-compatible provider (used when AI_PROVIDER=OpenAiCompatible)
# Definition: API key for the OpenAI-compatible endpoint, sent as a Bearer token.
# Type: string, secret (never commit it). Optional, local servers such as Ollama need none. Default: none.
AI_OPEN_AI_COMPATIBLE_API_KEY=ApiK***************************************************last
# Definition: base URL of the OpenAI-compatible API. The app calls {base URL}chat/completions.
# Type: URL. Format: absolute http or https URL ending with a slash, for example https://api.groq.com/openai/v1/. Optional. Default: https://api.groq.com/openai/v1/.
# Readiness reports degraded when a key would be sent over plain http to a host other than loopback.
AI_OPEN_AI_COMPATIBLE_BASE_URL=https://api.openai.com/v1/

# Open Library
# Definition: base URL of the Open Library API.
# Type: URL. Format: absolute http or https URL. Optional. Default: https://openlibrary.org/
OPEN_LIBRARY_BASE_URL=https://openlibrary.org/
# Definition: how many works get a detail lookup per search (to find their primary authors).
# Type: integer, above 0. Optional. Default: 6.
OPEN_LIBRARY_MAX_DETAIL_LOOKUPS=6
# Definition: how many authors of one work are looked up.
# Type: integer, above 0. Optional. Default: 3.
OPEN_LIBRARY_MAX_AUTHORS_PER_WORK=3
# Definition: how many Open Library requests run at the same time across the process.
# Type: integer, above 0. Optional. Default: 2.
OPEN_LIBRARY_MAX_CONCURRENT_REQUESTS=2
# Definition: how long all Open Library requests pause after an HTTP 429 that has no Retry-After header.
# Type: integer, seconds, above 0. Optional. Default: 30.
OPEN_LIBRARY_DEFAULT_COOLDOWN_SECONDS=30
# Definition: how long one Open Library attempt may take before it is cancelled and counted as a failure (it is retried while retries are left).
# Type: integer, milliseconds, above 0. Optional. Default: 10000.
OPEN_LIBRARY_RESILIENCE_ATTEMPT_TIMEOUT_MS=10000
# Definition: share of failed requests within the sampling window that opens the circuit. A 429 does not count, the cooldown handles it. While the circuit is open, searches fail with a 502 and send no request.
# Type: decimal number above 0 and at most 1. Optional. Default: 0.5.
OPEN_LIBRARY_RESILIENCE_CIRCUIT_BREAKER_FAILURE_RATIO=0.5
# Definition: fewest requests in the sampling window before the circuit may open.
# Type: integer, 2 or more. Optional. Default: 6.
OPEN_LIBRARY_RESILIENCE_CIRCUIT_BREAKER_MINIMUM_THROUGHPUT=6
# Definition: length of the window in which failures are counted.
# Type: integer, seconds, above 0. Optional. Default: 30.
OPEN_LIBRARY_RESILIENCE_CIRCUIT_BREAKER_SAMPLING_SECONDS=30
# Definition: how long an open circuit rejects requests before it lets one through to test Open Library again.
# Type: integer, seconds, above 0. Optional. Default: 20.
OPEN_LIBRARY_RESILIENCE_CIRCUIT_BREAKER_BREAK_SECONDS=20
# Definition: who to contact about this app's traffic, added to the User-Agent sent to Open Library (it asks API users to identify themselves).
# Type: string. Format: an email address or a URL. Optional. Default: empty (nothing is added). It is masked in logs.
OPEN_LIBRARY_CONTACT=noname@acme.org

# Search limits for POST /api/search: per client address per minute, and at once across all clients
# Definition: how many searches one client address may start per minute. More get a 429 with Retry-After.
# Type: integer, above 0. Optional. Default: 10.
API_RATE_LIMIT_SEARCH_PERMITS_PER_MINUTE=10
# Definition: how many searches may run at the same time across all clients. More get a 429 with Retry-After.
# Type: integer, above 0. Optional. Default: 8.
API_RATE_LIMIT_MAX_CONCURRENT_SEARCHES=8

# Health endpoints
# Definition: serves GET /api/health/config (masked configuration) and the per-dependency body of /api/health/ready to callers on the same machine only.
# Type: boolean, true or false. Optional. Default: false (the config endpoint answers 404).
API_HEALTH_EXPOSE_CONFIG=false

# Telemetry (OpenTelemetry over OTLP). Off unless enabled or an endpoint is set.
# Definition: turns the trace, metric and log export on.
# Type: boolean, true or false. Optional. Default: false. Setting OTEL_EXPORTER_OTLP_ENDPOINT also turns it on.
API_TELEMETRY_ENABLED=false
# Definition: logs the bodies of outgoing HTTP requests and responses (credentials are masked, bodies are cut at 8 KB).
# Type: boolean, true or false. Optional. Default: true.
API_TELEMETRY_LOG_HTTP_BODIES=true
# Definition: OTLP collector that receives the telemetry.
# Type: URL. Format: absolute http or https URL, usually the gRPC port 4317 (http://jaeger:4317 inside docker compose, http://localhost:4317 from the host). Optional. Default: empty (no export).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Definition: headers sent to the collector, for example an API key.
# Type: string, secret when it holds a key. Format: comma-separated key=value pairs, for example api-key=abc123,tenant=books. Optional. Default: empty.
OTEL_EXPORTER_OTLP_HEADERS=
# Definition: the service name shown in traces, metrics and logs.
# Type: string. Optional. Default: find-that-book.
OTEL_SERVICE_NAME=find-that-book
