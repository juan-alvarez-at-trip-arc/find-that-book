AI_PROVIDER=Gemini|OpenAiCompatible

# Generation settings sent to either provider. Blank means: temperature 0, and nothing else is sent.
# Temperature is 0 to 2, top-k is 1 or more, top-p is above 0 and at most 1, seed is any integer.
# Reasoning effort is a short word such as minimal, low, medium or high (the accepted words depend on the model).
# Gemini gets it as thinkingConfig.thinkingLevel, an OpenAI-compatible gateway as reasoning_effort.
# A gateway or model that does not support top-k, seed or reasoning effort may reject them (xAI accepted seed, top-p and reasoning effort for grok-4.7 on 2026-10-14), so leave those blank unless you have tried them.
AI_TEMPERATURE=
AI_TOP_K=
AI_TOP_P=
AI_SEED=
AI_REASONING_EFFORT=

GEMINI_API_KEY=ApiK*********************************************last
GEMINI_MODEL=auto

OPENAI_API_KEY=ApiK***************************************************last
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_MODEL=auto

# Open Library
OPENLIBRARY_BASE_URL=https://openlibrary.org/
OPENLIBRARY_MAX_DETAIL_LOOKUPS=6
OPENLIBRARY_MAX_AUTHORS_PER_WORK=3
OPENLIBRARY_MAX_CONCURRENT_REQUESTS=2
OPENLIBRARY_DEFAULT_COOLDOWN_SECONDS=30
OPENLIBRARY_CONTACT=noname@acme.org

# Search limits for POST /api/search: per client address per minute, and at once across all clients
RATE_LIMIT_SEARCHES_PER_MINUTE=10
RATE_LIMIT_MAX_CONCURRENT_SEARCHES=8

# Serve GET /api/health/config (masked configuration) to callers on the same machine. Off by default.
HEALTH_EXPOSE_CONFIG=false

# Telemetry (OpenTelemetry over OTLP). Off unless enabled or an endpoint is set.
TELEMETRY_ENABLED=false
TELEMETRY_LOG_HTTP_BODIES=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=find-that-book
