{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "Api": {
    "Telemetry": { "Enabled": false, "LogHttpBodies": true },
    "Health": { "ExposeConfig": false },
    "RateLimit": { "SearchPermitsPerMinute": 10, "MaxConcurrentSearches": 8 }
  },
  "Ai": {
    "Provider": "Gemini",
    "Model": null,
    "Temperature": 0,
    "TopK": null,
    "TopP": null,
    "Seed": null,
    "ReasoningEffort": null,
    "Gemini": { "ApiKey": "" },
    "OpenAiCompatible": { "ApiKey": "", "BaseUrl": "https://api.groq.com/openai/v1/" },
    "Resilience": {
      "RetryCount": 1,
      "RetryDelayMs": 300,
      "AttemptTimeoutMs": 30000,
      "TotalTimeoutMs": 45000,
      "BreakerFailureRatio": 0.5,
      "BreakerMinimumThroughput": 4,
      "BreakerSamplingSeconds": 30,
      "BreakerBreakSeconds": 30
    }
  },
  "OpenLibrary": {
    "BaseUrl": "https://openlibrary.org/",
    "Resilience": {
      "MaxRetries": 2,
      "RetryDelayMs": 300,
      "AttemptTimeoutMs": 10000,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 6,
      "CircuitBreakerSamplingSeconds": 30,
      "CircuitBreakerBreakSeconds": 20
    },
    "MaxDetailLookups": 6,
    "MaxAuthorsPerWork": 3,
    "MaxConcurrentRequests": 2,
    "DefaultCooldownSeconds": 30,
    "Contact": ""
  }
}
